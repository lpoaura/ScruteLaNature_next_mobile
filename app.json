{
  "expo": {
    "name": "Scrute La Nature",
    "slug": "scrute-la-nature",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo_bleu_SLN.png",
    "scheme": "scrutelanature",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.lpo.scrutelanature"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/Logo_bleu_SLN_padded.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "fr.lpo.scrutelanature",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo_bleu_SLN-ecritures.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "L'application a besoin d'accéder à votre position pour vous centrer sur la carte et trouver des parcours autour de vous.",
          "locationAlwaysPermission": "L'application a besoin d'accéder à votre position pour vous centrer sur la carte et trouver des parcours autour de vous.",
          "locationWhenInUsePermission": "L'application a besoin d'accéder à votre position pour vous centrer sur la carte et trouver des parcours autour de vous."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07059e34-67b4-48fd-a066-84a2f995421a"
      }
    },
    "owner": "devlpo"
  }
}
